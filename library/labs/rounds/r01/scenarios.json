      "inputs": { "bsCash": 1000, "fs": { "bs_ar": 0, "bs_ap": 400, "bs_debt": 100, "bs_equity": 1000, "pl_revenue": 1000, "pl_cogs": 300, "pl_opex": 100, "cf_op": 10 } },
