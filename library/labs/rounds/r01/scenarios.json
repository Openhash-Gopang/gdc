    { "id": "xfer-008", "kind": "transfer", "product": "wallet", "moves_balance": true, "note": "음수 금액",
      "inputs": { "amount": -5, "outflowToday": 0, "recipientKnown": true }, "expected": { "ok": false, "code": "AMOUNT_INVALID" } },
    { "id": "xfer-009", "kind": "transfer", "product": "wallet", "moves_balance": true, "note": "검사 순서: 1회 상한과 신규 수취인·1일 상한을 동시에 넘으면 1회 상한이 먼저",
      "inputs": { "amount": 1001, "outflowToday": 1990, "recipientKnown": false }, "expected": { "ok": false, "code": "PER_TX_LIMIT" } },
    { "id": "xfer-010", "kind": "transfer", "product": "wallet", "moves_balance": true, "note": "검사 순서: 신규 수취인 상한이 1일 상한보다 먼저",
      "inputs": { "amount": 150, "outflowToday": 1990, "recipientKnown": false }, "expected": { "ok": false, "code": "NEW_RECIPIENT_LIMIT" } },
    { "id": "xfer-011", "kind": "transfer", "product": "wallet", "moves_balance": true, "note": "숫자가 아닌 금액(문자열)",
