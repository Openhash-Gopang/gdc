      "inputs": { "bsCash": 500, "fs": { "bs_ar": 300, "bs_ap": 500, "bs_debt": 700, "bs_equity": 1000, "pl_revenue": 5000, "pl_cogs": 3000, "pl_opex": 1000, "cf_op": 150 } },
