      "inputs": { "bsCash": 200, "fs": { "bs_ar": 100, "bs_ap": 300, "bs_debt": 1000, "bs_equity": 1000, "pl_revenue": 4000, "pl_cogs": 2500, "pl_opex": 1100, "cf_op": 150 } },
      "expected": { "grade": "BBB", "annualRate": 0.025, "score": 61.25 }
