      "inputs": { "bsCash": 500, "fs": { "bs_ar": 500, "bs_ap": 500, "bs_debt": 100, "bs_equity": 1000, "pl_revenue": 1000, "pl_cogs": 800, "pl_opex": 400, "cf_op": 50 } },
