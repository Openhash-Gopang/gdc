      "inputs": { "bsCash": 100, "fs": { "bs_ar": 0, "bs_ap": 0, "bs_debt": 0, "bs_equity": 0, "pl_revenue": 0, "pl_cogs": 0, "pl_opex": 0, "cf_op": 0 } },
