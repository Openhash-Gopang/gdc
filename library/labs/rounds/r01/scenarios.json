      "inputs": { "bsCash": 100, "fs": { "bs_ar": 0, "bs_ap": 100, "bs_debt": 0, "bs_equity": 1000, "pl_revenue": 1000, "pl_cogs": 500, "pl_opex": 300, "cf_op": 100 } },
