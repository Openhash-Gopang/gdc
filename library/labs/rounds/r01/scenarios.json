    { "id": "xfer-005", "kind": "transfer", "product": "wallet", "moves_balance": true, "note": "신규 수취인 상한과 같은 금액 — 통과",
      "inputs": { "amount": 100, "outflowToday": 0, "recipientKnown": false }, "expected": { "ok": true, "code": "OK" } },
    { "id": "xfer-006", "kind": "transfer", "product": "wallet", "moves_balance": true, "note": "신규 수취인 상한 +1",
